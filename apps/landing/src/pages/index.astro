---
import ChaosToCalm from '../components/ChaosToCalm.astro'
import Contours from '../components/scene/Contours.astro'
import FilmSection from '../components/FilmSection.astro'
import Footer from '../components/Footer.astro'
import GetExtension from '../components/GetExtension.astro'
import GitHubMark from '../components/GitHubMark.astro'
import HeroDemo from '../components/HeroDemo.astro'
import Icon from '../components/Icon.astro'
import Nav from '../components/Nav.astro'
import PromoFilm from '../components/PromoFilm.astro'
import Sky from '../components/scene/Sky.astro'
import Valley from '../components/scene/Valley.astro'
import StickyShowcase from '../components/StickyShowcase.astro'
import Terminal from '../components/Terminal.astro'
import Layout from '../layouts/Layout.astro'
import { extensionUrl, faq, nb, repo } from '../site'

const features = [
  [
    'Columns3',
    'Kanban boards',
    'Categories, groups and big emoji headers. Resize, collapse, reorder — all by drag and drop.',
  ],
  ['Rows3', 'Collections view', 'The same groups as wide panels of link cards, per category.'],
  [
    'PanelLeft',
    'Open tabs panel',
    'All windows and Chrome tab groups. Save a selection, close duplicates.',
  ],
  [
    'MousePointerClick',
    'Save from any page',
    'Right-click menu and a Ctrl+Shift+S popover with a sticky note.',
  ],
  ['Search', 'Instant search', 'Workspaces, open tabs and bookmarks in one Ctrl+K palette.'],
  ['Bell', 'Reminders', 'One-time, weekly or monthly — with notifications and snooze.'],
  ['Layers', 'Notes, to-dos, stacks', 'Nine colors, /todo shortcuts, links stacked side by side.'],
  ['Undo2', 'Undo and bin', 'Every change can be undone; deleted things wait in the bin.'],
  [
    'Download',
    'Import and export',
    'JSON, bookmarks and CSV. Bring Chrome bookmark folders along.',
  ],
  ['Keyboard', 'Keyboard first', 'Rebindable shortcuts and a cheat sheet on the ? key.'],
  ['Languages', 'Light, dark, compact', 'Themes, density and English or Polish.'],
  ['ShieldCheck', 'No tracking', 'No analytics, no ads, no access to pages until you click.'],
] as const

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
}

const filmSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: 'TabCabin in under a minute',
  description:
    'A short film about the TabCabin browser extension: dragging tabs into groups, saving any page with a note, to-dos, search, collections, reminders, dark mode and sync between computers.',
  thumbnailUrl: new URL('/promo-poster.jpg', Astro.site).toString(),
  contentUrl: new URL('/promo.mp4', Astro.site).toString(),
  uploadDate: '2026-10-08',
  duration: 'PT50S',
}
---

<Layout
  title="TabCabin — a calm, open-source tab manager with kanban boards and sync"
  description="A calm cabin for your tabs: TabCabin turns every new tab into kanban boards for tabs, links, notes and to-dos. A free, open-source Chrome extension that works offline, syncs your computers when you sign in, and can run on your own server."
  schema={[faqSchema, filmSchema]}
>
  <Nav />
  <main>
    <!-- Hero: a quiet valley by day; in the dark theme the same valley at night. -->
    <section class="relative -mt-16 overflow-hidden">
      <div class="scene-sky relative isolate">
        <Sky id="hero-sky" />
        <div class="relative mx-auto max-w-6xl px-5 pt-[120px] text-center sm:pt-36">
          {extensionUrl && (
            <a
              href={extensionUrl}
              class="mb-6 inline-flex items-center gap-1.5 text-[14.5px] text-ink-2 underline decoration-accent/40 underline-offset-[5px] hover:text-ink hover:decoration-accent"
            >
              Sync between your computers is here <Icon name="ArrowRight" size={14} />
            </a>
          )}
          <h1 class="mx-auto max-w-4xl text-[44px] leading-[1.02] font-bold tracking-[-0.04em] text-balance sm:text-[72px]">
            A <span class="text-accent-ink">calm</span> cabin for your tabs
          </h1>
          <p class="mx-auto mt-6 max-w-2xl text-[18px] leading-relaxed text-balance text-ink-2 sm:text-[20px]">
            An <span class="whitespace-nowrap">open-source</span> tab manager that turns every new
            tab into quiet boards for your tabs, links, notes and{' '}
            <span class="whitespace-nowrap">to-dos</span>. Works offline, no account needed. Sign in
            to sync your computers, or run your own server.
          </p>
          <div class="mt-9 flex flex-wrap items-center justify-center gap-3" data-reveal="0.2">
            <GetExtension label="Get it for Chrome" />
            {repo && (
              <a
                href={repo}
                data-umami-event="GitHub"
                class="flex h-12 items-center gap-2 rounded-xl bg-card px-6 text-[15.5px] font-semibold shadow-tile transition hover:bg-raised"
              >
                <GitHubMark size={18} /> Star on GitHub
              </a>
            )}
            <PromoFilm />
          </div>
          <p class="mt-4 text-[13.5px] text-ink-3" data-reveal="0.25">
            Free & MIT licensed · Chrome, Edge, Brave · no account needed
          </p>
        </div>
        <div class="relative -z-10 -mt-[clamp(24px,9vw,130px)] h-[clamp(220px,34vw,480px)]">
          <Valley />
        </div>
      </div>
      <div
        class="relative mx-auto -mt-[clamp(90px,14vw,210px)] max-w-6xl px-5 pb-28"
        data-reveal="0.3"
      >
        <HeroDemo />
      </div>
    </section>

    <ChaosToCalm />

    <StickyShowcase />

    <FilmSection />

    <!-- Feature grid -->
    <section id="features" class="scroll-mt-20 border-y border-line bg-panel/60 py-24">
      <div class="mx-auto max-w-6xl px-5">
        <h2 class="text-center text-[34px] font-semibold tracking-[-0.03em] sm:text-[44px]">
          Small details, everywhere
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-center text-[17px] text-ink-2" data-reveal="0.05">
          Built by someone who keeps thirty tabs open “for later” — and wanted a calm place to keep
          them.
        </p>
        <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {features.map(([icon, title, text], index) => (
            <article
              class="rounded-[18px] bg-card p-6 shadow-card"
              data-reveal={(index % 4) * 0.06}
            >
              <span class="flex size-11 items-center justify-center rounded-xl bg-accent-soft text-accent-ink">
                <Icon name={icon} size={21} />
              </span>
              <h3 class="mt-5 text-[16.5px] font-semibold tracking-[-0.01em]">{title}</h3>
              <p class="mt-2 text-[14.5px] leading-relaxed text-ink-2" set:html={nb(text)} />
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Self-host -->
    <section id="self-host" class="relative scroll-mt-20 py-28">
      <Contours />
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 lg:grid-cols-2">
        <div class="min-w-0" data-reveal>
          <span class="text-[13px] font-semibold tracking-[0.08em] text-accent-ink uppercase">
            Or run your own
          </span>
          <h2 class="mt-3 text-[34px] leading-tight font-semibold tracking-[-0.03em] sm:text-[42px]">
            Your server. Your data. Every browser in sync.
          </h2>
          <p class="mt-5 text-[16.5px] leading-relaxed text-ink-2">
            Sync works as soon as you sign in. If you would rather keep everything on your own
            machine, run the sync server yourself: one small container with an SQLite database.
            Caddy gets the HTTPS certificate, a backup script keeps seven nightly copies, and you
            build the extension with your server’s address.
          </p>
          <ul class="mt-6 flex flex-col gap-2.5 text-[15px] text-ink-2">
            {[
              'Google or username and password, sign-up off by default',
              'Live updates, offline edits merge when you reconnect',
              'Docker images for amd64 and arm64 (a Raspberry Pi is enough)',
              'No telemetry, no third-party services',
            ].map((point) => (
              <li class="flex items-start gap-2.5">
                <span class="mt-0.5 text-success">
                  <Icon name="Check" size={18} />
                </span>
                {point}
              </li>
            ))}
          </ul>
          <a
            href="/self-hosted-tab-manager/"
            class="mt-8 inline-flex items-center gap-2 text-[15px] font-semibold text-accent-ink hover:underline"
          >
            How self-hosting works <Icon name="ArrowRight" size={16} />
          </a>
        </div>
        <div class="min-w-0" data-reveal="0.1">
          <Terminal />
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="scroll-mt-20 border-t border-line bg-panel/60 py-24">
      <div class="mx-auto max-w-3xl px-5">
        <h2 class="text-center text-[34px] font-semibold tracking-[-0.03em] sm:text-[44px]">
          Questions, answered
        </h2>
        <div class="mt-12 flex flex-col gap-3">
          {faq.map((item, index) => (
            <details
              class="group rounded-[16px] bg-card px-5 py-4 shadow-tile open:shadow-card"
              data-reveal={index * 0.04}
            >
              <summary class="flex list-none items-center justify-between gap-4 text-[16px] font-semibold [&::-webkit-details-marker]:hidden">
                {item.q}
                <span class="text-ink-3 transition-transform duration-200 group-open:rotate-45">
                  <Icon name="Plus" size={18} />
                </span>
              </summary>
              <p
                class="mt-3 text-[15px] leading-relaxed text-ink-2"
                set:html={item.html ?? nb(item.a)}
              />
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Call to action -->
    <section class="py-28 text-center">
      <div class="mx-auto max-w-3xl px-5" data-reveal>
        <h2 class="text-[36px] leading-tight font-semibold tracking-[-0.035em] sm:text-[52px]">
          Close the tabs.
          <br />
          Keep the thoughts.
        </h2>
        <p class="mx-auto mt-5 max-w-xl text-[17px] text-ink-2">
          Free and open source. Move in within a minute, sync when you are ready.
        </p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <GetExtension label="Get it for Chrome" />
          <a
            href="/alternatives/"
            class="flex h-12 items-center gap-2 rounded-xl bg-card px-6 text-[15.5px] font-semibold shadow-tile transition hover:bg-raised"
          >
            Compare with other tab managers
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
