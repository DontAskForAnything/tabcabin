---
/**
 * The promo film inline. On wide screens it plays muted while on screen, as a preview; the button
 * starts it from the beginning with sound and the browser's controls. On phones (and with reduced
 * motion) it waits on its poster, and the button plays it full screen with sound.
 */
import Icon from './Icon.astro'
import { poster } from '../lib/poster'
---

<section class="py-24" id="demo">
  <div class="mx-auto max-w-6xl px-5">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-[34px] font-semibold tracking-[-0.03em] sm:text-[44px]">
        See it in under a minute
      </h2>
      <p class="mt-4 text-[17px] text-ink-2" data-reveal="0.05">
        Dragging tabs into groups, saving any page with a note,{' '}
        <span class="whitespace-nowrap">to-dos</span>, search, collections, reminders, the dark
        theme and sync.
      </p>
    </div>
    <div
      class="relative mt-12 overflow-hidden rounded-[22px] bg-black shadow-pop ring-1 ring-line"
      data-reveal="0.1"
    >
      <video
        class="block aspect-video w-full"
        src="/promo.mp4"
        poster={poster.src}
        muted
        loop
        playsinline
        preload="none"
        aria-label="TabCabin film"
        data-film-video
      ></video>
      <button
        type="button"
        class="group absolute bottom-1.5 left-1/2 flex h-10 -translate-x-1/2 items-center gap-2.5 rounded-full bg-[#faf6ee]/92 py-1.5 pr-4 pl-1.5 text-[14px] font-semibold whitespace-nowrap text-[#0f1110] shadow-pop backdrop-blur transition hover:bg-[#faf6ee] md:bottom-5 md:left-5 md:h-12 md:translate-x-0 md:gap-3 md:py-2 md:pr-5 md:pl-2 md:text-[15px]"
        data-film-play
        data-umami-event="Play film"
      >
        <span class="flex size-7 items-center justify-center rounded-full bg-[#1f4a3a] text-[#faf6ee] transition group-hover:scale-110 md:size-8">
          <Icon name="Play" size={14} class="translate-x-px fill-current" />
        </span>
        <span class="md:hidden">Watch the film</span>
        <span class="hidden md:inline">Watch with sound</span>
        <span class="font-medium text-[#5d635f] tabular-nums">0:50</span>
      </button>
    </div>
    <p class="mt-5 text-center" data-reveal="0.12">
      <a href="/film/" class="text-[15px] font-medium text-accent-ink hover:underline">
        Watch it scene by scene
      </a>
    </p>
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-film-video]')
  const play = document.querySelector<HTMLButtonElement>('[data-film-play]')
  const preview =
    matchMedia('(min-width: 768px)').matches &&
    !matchMedia('(prefers-reduced-motion: reduce)').matches
  let withSound = false

  // The muted preview loads and plays only while the film is on screen.
  if (video && preview) {
    new IntersectionObserver(
      ([entry]) => {
        if (entry?.isIntersecting) void video.play().catch(() => undefined)
        else video.pause()
      },
      { threshold: 0.4 },
    ).observe(video)
  }

  play?.addEventListener('click', () => {
    if (!video) return
    withSound = true
    play.hidden = true
    video.loop = false
    video.muted = false
    video.controls = true
    video.currentTime = 0
    void video.play().catch(() => undefined)
    if (!preview) {
      // Phones: full screen (iOS Safari only knows its own video call).
      const element = video as HTMLVideoElement & { webkitEnterFullscreen?: () => void }
      if (element.requestFullscreen) void element.requestFullscreen().catch(() => undefined)
      else element.webkitEnterFullscreen?.()
    }
  })
  video?.addEventListener('ended', () => {
    if (withSound && play) play.hidden = false
  })
</script>
