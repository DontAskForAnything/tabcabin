---
import Footer from '../../components/Footer.astro'
import Icon from '../../components/Icon.astro'
import Nav from '../../components/Nav.astro'
import Layout from '../../layouts/Layout.astro'
import { versus, versusPath } from '../../versus'

const tools = [
  [
    'OneTab',
    'onetab',
    'Collapse tabs into a list — or give them a board with notes and reminders.',
  ],
  [
    'Toby',
    'toby',
    'Collections of tabs, plus kanban boards, notes and reminders, without an account.',
  ],
  ['Workona', 'workona', 'Workspaces without an account or limits, free and open source.'],
  [
    'tabExtend',
    'tabextend',
    'A board of tabs, notes and to-dos on the new tab page, without a limit on saves.',
  ],
  [
    'Session Buddy',
    'session-buddy',
    'Saved sessions you come back to, on boards with notes, to-dos and reminders.',
  ],
]
---

<Layout
  title="OneTab, Toby, Workona and more alternatives — TabCabin"
  description="How TabCabin compares with popular tab managers: boards, notes, reminders, privacy, price and self-hosted sync."
  path="/alternatives/"
  breadcrumbs={[['Alternatives', '/alternatives/']]}
>
  <Nav />
  <main class="mx-auto max-w-4xl px-5 py-16 sm:py-24">
    <h1
      class="text-[38px] leading-[1.08] font-semibold tracking-[-0.035em] sm:text-[52px]"
      data-reveal
    >
      Tab managers, compared
    </h1>
    <p class="mt-6 max-w-2xl text-[18px] leading-relaxed text-ink-2" data-reveal="0.05">
      TabCabin is a free, open-source tab manager with kanban boards, notes, reminders and optional
      sync you can also host yourself. Here is how it stacks up against tools you may already use.
    </p>
    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      {tools.map(([name, slug, text], index) => (
        <a
          href={`/alternatives/${slug}/`}
          class="flex flex-col rounded-[18px] bg-card p-6 shadow-card transition-transform hover:-translate-y-0.5"
          data-reveal={index * 0.06}
        >
          <span class="text-[19px] font-semibold">TabCabin vs {name}</span>
          <span class="mt-2 flex-1 text-[14.5px] leading-relaxed text-ink-2">{text}</span>
          <span class="mt-5 inline-flex items-center gap-1.5 text-[14px] font-semibold text-accent-ink">
            Compare <Icon name="ArrowRight" size={15} />
          </span>
        </a>
      ))}
    </div>

    <h2 class="mt-20 text-[28px] font-semibold tracking-[-0.025em]" data-reveal>
      Head to head
    </h2>
    <p class="mt-3 max-w-2xl text-[16px] leading-relaxed text-ink-2" data-reveal="0.05">
      Choosing between two of them? Here is how they differ, and when a third option fits better.
    </p>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {versus.map((pair, index) => (
        <li data-reveal={index * 0.06}>
          <a
            href={versusPath(pair.slug)}
            class="flex items-center justify-between gap-3 rounded-[16px] bg-card px-5 py-4 font-semibold shadow-card transition-transform hover:-translate-y-0.5"
          >
            {pair.crumb}
            <span class="text-accent-ink">
              <Icon name="ArrowRight" size={16} />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </main>
  <Footer />
</Layout>
