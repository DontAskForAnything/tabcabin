---
import { Image } from 'astro:assets'
import board from '../../../../docs/screenshots/board-light.png'
import collections from '../../../../docs/screenshots/collections-light.png'
import popover from '../../../../docs/screenshots/popover.png'
import reminders from '../../../../docs/screenshots/reminders.png'
import search from '../../../../docs/screenshots/search.png'
import { nb } from '../site'
import BrowserWindow from './BrowserWindow.astro'

const ARTICLE = {
  page: 'article' as const,
  title: 'Designing calm software · Field notes',
  url: 'journal.example.dev/calm-software',
}
const NEW_TAB = { page: 'newtab' as const, title: 'New Tab', url: undefined }

const steps = [
  {
    image: board,
    kicker: 'Board',
    tab: NEW_TAB,
    title: 'Every tab gets a place to stay',
    text: 'Categories across the top, groups as columns with big emoji headers. Links, notes, to-dos, images and stacks live side by side — and everything is drag and drop.',
  },
  {
    image: collections,
    kicker: 'Collections',
    tab: NEW_TAB,
    title: 'Or see it all as cards',
    text: 'Switch any category to wide panels of link tiles. Same data, calmer overview — open a whole group with one click.',
  },
  {
    image: popover,
    kicker: 'Capture',
    tab: ARTICLE,
    title: 'Save without leaving the page',
    text: 'Ctrl+Shift+S opens a small popover: add a sticky note, pick the group, set a reminder, close the tab. The right-click menu saves links, images and selected text.',
  },
  {
    image: search,
    kicker: 'Search',
    tab: NEW_TAB,
    title: 'Find anything in a keystroke',
    text: 'Ctrl+K searches titles, addresses and notes across workspaces, open tabs and bookmarks, then jumps straight to the result on your board.',
  },
  {
    image: reminders,
    kicker: 'Reminders',
    tab: NEW_TAB,
    title: 'Come back to what matters',
    text: 'One-time, weekly or monthly reminders on any link or to-do, with desktop notifications, snooze and a due count on the toolbar icon.',
  },
]
---

<section class="py-24" data-showcase>
  <div class="mx-auto grid max-w-6xl gap-10 px-5 lg:grid-cols-[0.9fr_1.3fr] lg:gap-16">
    <ol class="flex flex-col">
      {steps.map((step, index) => (
        <li
          class="showcase-step flex flex-col justify-center py-10 lg:min-h-[78vh]"
          data-step={index}
        >
          <span class="text-[13px] font-semibold tracking-[0.08em] text-accent-ink uppercase">
            {String(index + 1).padStart(2, '0')} · {step.kicker}
          </span>
          <h3 class="mt-3 text-[28px] leading-tight font-semibold tracking-[-0.025em] sm:text-[34px]">
            {step.title}
          </h3>
          <p
            class="mt-4 max-w-md text-[16.5px] leading-relaxed text-ink-2"
            set:html={nb(step.text)}
          />
          <BrowserWindow
            page={step.tab.page}
            title={step.tab.title}
            url={step.tab.url}
            class="mt-8 lg:hidden"
          >
            <Image
              src={step.image}
              alt=""
              widths={[720, 1080]}
              sizes="100vw"
              class="block w-full"
            />
          </BrowserWindow>
        </li>
      ))}
    </ol>
    <div class="hidden lg:block">
      <BrowserWindow class="sticky top-[14vh]">
        <div class="relative aspect-[1440/900] w-full">
          {steps.map((step, index) => (
            <div
              class="showcase-shot absolute inset-0"
              data-shot={index}
              data-page={step.tab.page}
              data-title={step.tab.title}
              data-url={step.tab.url ?? ''}
              style={index === 0 ? '' : 'opacity:0'}
            >
              <Image
                src={step.image}
                alt={step.title}
                widths={[900, 1300]}
                sizes="(min-width: 1180px) 700px, 60vw"
                class="block h-full w-full object-cover object-left-top"
              />
            </div>
          ))}
        </div>
      </BrowserWindow>
    </div>
  </div>
</section>

<script>
  import { animate } from 'motion'

  const root = document.querySelector<HTMLElement>('[data-showcase]')
  if (root) {
    const shots = [...root.querySelectorAll<HTMLElement>('[data-shot]')]
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')]
    const browser = root.querySelector<HTMLElement>('.hidden [data-browser]')
    const urlBox = browser?.querySelector<HTMLElement>('[data-browser-url]')
    const placeholder = urlBox?.innerHTML ?? ''
    /** The tab title, icon and address follow the page on screen. */
    const showPage = (shot: HTMLElement) => {
      if (!browser || !urlBox) return
      const { page, title, url } = shot.dataset
      browser.querySelector('[data-browser-title]')!.textContent = title ?? ''
      browser.querySelectorAll<HTMLElement>('[data-browser-icon]').forEach((icon) => {
        icon.hidden = icon.dataset.browserIcon !== page
      })
      if (url) urlBox.textContent = url
      else urlBox.innerHTML = placeholder
    }
    let active = 0
    const show = (index: number) => {
      if (index === active) return
      const previous = shots[active]
      const next = shots[index]
      active = index
      if (previous) void animate(previous, { opacity: 0, scale: 0.985 }, { duration: 0.35 })
      if (next) {
        showPage(next)
        void animate(next, { opacity: [0, 1], scale: [1.015, 1] }, { duration: 0.45 })
      }
      steps.forEach((step, i) => step.classList.toggle('is-active', i === index))
    }
    steps[0]?.classList.add('is-active')
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries)
          if (entry.isIntersecting) show(Number((entry.target as HTMLElement).dataset.step))
      },
      { rootMargin: '-45% 0px -45% 0px' },
    )
    steps.forEach((step) => observer.observe(step))
  }
</script>

<style>
  @media (min-width: 1024px) {
    .showcase-step {
      opacity: 0.35;
      transition: opacity 0.35s ease;
    }
    .showcase-step:global(.is-active) {
      opacity: 1;
    }
  }
</style>
