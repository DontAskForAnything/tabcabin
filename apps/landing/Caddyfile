# The website inside its container (apps/landing/Dockerfile). The proxy in front of it handles
# HTTPS and the domain.
:80 {
	root * /srv
	# For the container's health check and the host's (Coolify): no files involved.
	respond /health "ok" 200
	encode zstd gzip
	file_server
	# Fingerprinted assets never change.
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
