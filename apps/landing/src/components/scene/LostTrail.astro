---
/**
 * The 404 scene: a signpost made of browser tabs at the edge of the forest, a lantern, and the
 * trail down to the cabin. The signs are real links. Morning in the light theme, night in the
 * dark one.
 */
import { forest, land, mountains, round, ridge, seeded, spruce } from '../../lib/landscape'
import Cabin from './Cabin.astro'
import TabSign from './TabSign.astro'

const width = 1280
const height = 800
const rand = seeded(404)
const post = 600
const cabinX = 900

const range = mountains(
  [
    [-20, 470],
    [120, 420],
    [260, 452],
    [420, 400],
    [560, 446],
    [700, 424],
    [860, 380],
    [1000, 428],
    [1140, 396],
    [1300, 440],
  ],
  height,
  rand,
)
const far = forest({
  width,
  bottom: height,
  y: ridge({ base: 482, amp: 8, phase: 1.4 }),
  rand,
  gap: 12,
  min: 16,
  max: 34,
})
const middleGround = ridge({ base: 522, amp: 10, phase: 2.2 })
const cabinY = middleGround(cabinX)
const middle = forest({
  width,
  bottom: height,
  y: ridge({ base: 522, amp: 10, phase: 2.2, pin: { x: cabinX, y: cabinY, reach: 70 } }),
  rand,
  gap: 18,
  min: 28,
  max: 58,
  skip: (x) => Math.abs(x - cabinX) < 42,
})
const meadow = land(ridge({ base: 556, amp: 6, phase: 0.3 }), width, height)
const saplings = [
  [452, 708, 46],
  [486, 716, 30],
  [740, 690, 40],
  [1010, 640, 52],
  [1050, 652, 34],
  [230, 650, 44],
]
  .map(([x, y, tall]) => spruce(x!, y!, tall!, tall! * 0.44))
  .join('')
const front = [
  [-40, 440],
  [40, 320],
  [112, 210],
  [1180, 270],
  [1240, 390],
  [1312, 470],
]
  .map(([x, tall]) => spruce(x!, 822, tall!, tall! * 0.42))
  .join('')
const fireflies = Array.from({ length: 16 }, () => ({
  x: round(rand() < 0.5 ? 200 + rand() * 300 : 960 + rand() * 260),
  y: round(600 + rand() * 140),
  delay: `${(-rand() * 9).toFixed(1)}s, ${(-rand() * 3).toFixed(1)}s`,
}))
const nails = [421, 483, 545]
---

<!--
  On a phone the drawing keeps a fixed small scale (806 × 504), wide enough for the signpost and
  the cabin; from the small breakpoint up it fills the scene.
-->
<svg
  class="absolute bottom-0 left-1/2 -ml-[450px] h-[504px] w-[806px] sm:inset-0 sm:ml-0 sm:h-full sm:w-full"
  viewBox={`-35 0 ${width} ${height}`}
  preserveAspectRatio="xMidYMax slice"
  role="group"
  aria-label="A signpost made of browser tabs"
>
  <defs>
    <linearGradient id="lost-mist" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--scene-sky-bottom); stop-opacity: 0"></stop>
      <stop offset="1" style="stop-color: var(--scene-sky-bottom); stop-opacity: 0.85"></stop>
    </linearGradient>
    <radialGradient id="lost-firefly">
      <stop offset="0" stop-color="#F4EAD5" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#F4EAD5" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="lost-lamp">
      <stop offset="0" stop-color="#F4EAD5" stop-opacity="0.4"></stop>
      <stop offset="0.45" stop-color="#F4EAD5" stop-opacity="0.16"></stop>
      <stop offset="1" stop-color="#F4EAD5" stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  <g class="scene-sun">
    <circle cx="1080" cy="404" r="86" opacity="0.35" style="fill: var(--scene-sun)"></circle>
    <circle cx="1080" cy="404" r="54" style="fill: var(--scene-sun)"></circle>
  </g>
  <path d={range} style="fill: var(--scene-mountain)"></path>
  <rect x="-20" y="420" width="1320" height="80" fill="url(#lost-mist)"></rect>
  <path d={far} style="fill: var(--scene-far)"></path>
  <rect x="-20" y="470" width="1320" height="60" fill="url(#lost-mist)" opacity="0.7"></rect>
  <path d={middle} style="fill: var(--scene-middle)"></path>
  <Cabin x={cabinX} y={Math.round(cabinY + 1)} scale={1.6} id="lost-cabin" />
  <path d={meadow} style="fill: var(--scene-near)"></path>
  <path
    d="M700 800 C 760 710, 860 630, 906 560 L 924 560 C 916 640, 900 720, 930 800 Z"
    style="fill: var(--scene-path)"
    opacity="0.85"
  ></path>

  <!-- Lantern light on the grass: soft by day, warm at night. -->
  <ellipse
    cx="540"
    cy="706"
    rx="250"
    ry="52"
    fill="url(#lost-lamp)"
    style="opacity: calc(0.3 + var(--scene-night) * 0.7)"
  ></ellipse>
  <path d={saplings} style="fill: var(--scene-front)"></path>

  <!-- The post. -->
  <ellipse cx={post} cy="704" rx="44" ry="8" style="fill: var(--scene-front)"></ellipse>
  <rect x={post - 8} y="372" width="16" height="334" rx="3" style="fill: var(--scene-post)"></rect>
  <path d={`M${post - 10} 374 h20 l-10 -16 z`} style="fill: var(--scene-post)"></path>

  <TabSign
    href="/"
    label="Home"
    x={post + 16}
    y={398}
    width={200}
    tilt={-3}
    nail={[post, nails[0]!]}
    arrow="right"
  />
  <TabSign
    href="/#features"
    label="Features"
    x={post - 206}
    y={460}
    width={190}
    tilt={2.5}
    nail={[post, nails[1]!]}
    arrow="left"
  />
  <TabSign
    href="/self-hosted-tab-manager/"
    label="Self-host"
    x={post + 16}
    y={522}
    width={200}
    tilt={-1.5}
    nail={[post, nails[2]!]}
    arrow="right"
  />
  {nails.map((y) => (
    <circle cx={post} cy={y} r="3" class="fill-ink-3" />
  ))}

  <!-- The 404 tab lost a nail and hangs by one string. -->
  <g class="lost-hanging" style={`transform-origin: ${post}px 598px`}>
    <g transform={`rotate(12 ${post} 598)`}>
      <path d={`M${post} 598 L${post - 44} 614`} stroke-width="1.5" class="stroke-ink-3"></path>
      <rect
        x={post - 58}
        y="619"
        width="116"
        height="38"
        rx="10"
        fill="#0F1110"
        opacity="0.14"
      ></rect>
      <rect x={post - 58} y="614" width="116" height="38" rx="10" fill="#E9DFC6"></rect>
      <text x={post} y="639.5" text-anchor="middle" class="lost-404">
        404
      </text>
    </g>
  </g>
  <circle cx={post} cy="598" r="3" class="fill-ink-3"></circle>

  <!-- Lantern on a bracket. -->
  <path
    d={`M${post} 386 H${post - 68} V398`}
    fill="none"
    stroke-width="5"
    stroke-linecap="round"
    style="stroke: var(--scene-post)"
  ></path>
  <g transform={`translate(${post - 68} 0)`}>
    <circle
      cx="0"
      cy="424"
      r="120"
      fill="url(#lost-lamp)"
      style="opacity: calc(0.35 + var(--scene-night) * 0.65)"
    ></circle>
    <path d="M-12 402 h24 l-4 -6 h-16 z" style="fill: var(--scene-post)"></path>
    <rect
      x="-10"
      y="402"
      width="20"
      height="30"
      rx="4"
      fill="#F4EAD5"
      style="filter: drop-shadow(0 0 8px #F4EAD5)"
    ></rect>
    <path d="M-10 417 h20 M0 402 v30" stroke="#C9B98F" stroke-width="1.2"></path>
    <rect x="-12" y="432" width="24" height="5" rx="1.5" style="fill: var(--scene-post)"></rect>
  </g>

  <g class="scene-by-night">
    {fireflies.map((fly) => (
      <g transform={`translate(${fly.x} ${fly.y})`}>
        <g class="scene-firefly" style={`animation-delay:${fly.delay}`}>
          <circle r="7" fill="url(#lost-firefly)" />
          <circle r="1.8" fill="#EEF3C9" />
        </g>
      </g>
    ))}
  </g>
  <path d={front} style="fill: var(--scene-front)"></path>
</svg>

<style>
  .lost-404 {
    fill: #1f4a3a;
    font:
      700 17px 'Bricolage Grotesque Variable',
      system-ui,
      sans-serif;
  }
  .lost-hanging {
    animation: lost-sway 3.4s ease-in-out infinite alternate;
  }
  @keyframes lost-sway {
    from {
      transform: rotate(-3deg);
    }
    to {
      transform: rotate(4deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lost-hanging {
      animation: none;
    }
  }
</style>
