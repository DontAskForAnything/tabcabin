---
import ChaosToCalm from '../components/ChaosToCalm.astro'
import DemoVideo from '../components/DemoVideo.astro'
import Footer from '../components/Footer.astro'
import GitHubMark from '../components/GitHubMark.astro'
import HeroDemo from '../components/HeroDemo.astro'
import Icon from '../components/Icon.astro'
import Nav from '../components/Nav.astro'
import PromoFilm from '../components/PromoFilm.astro'
import StickyShowcase from '../components/StickyShowcase.astro'
import Terminal from '../components/Terminal.astro'
import Layout from '../layouts/Layout.astro'
import { faq, nb, repo, releases } from '../site'

const features = [
  [
    'Columns3',
    'Kanban boards',
    'Categories, groups and big emoji headers. Resize, collapse, reorder — all by drag and drop.',
  ],
  ['Rows3', 'Collections view', 'The same groups as wide panels of link cards, per category.'],
  [
    'PanelLeft',
    'Open tabs panel',
    'All windows and Chrome tab groups. Save a selection, close duplicates.',
  ],
  [
    'MousePointerClick',
    'Save from any page',
    'Right-click menu and a Ctrl+Shift+S popover with a sticky note.',
  ],
  ['Search', 'Instant search', 'Workspaces, open tabs and bookmarks in one Ctrl+K palette.'],
  ['Bell', 'Reminders', 'One-time, weekly or monthly — with notifications and snooze.'],
  ['Layers', 'Notes, to-dos, stacks', 'Nine colors, /todo shortcuts, links stacked side by side.'],
  ['Undo2', 'Undo and bin', 'Every change can be undone; deleted things wait in the bin.'],
  [
    'Download',
    'Import and export',
    'JSON, bookmarks and CSV. Bring Chrome bookmark folders along.',
  ],
  ['Keyboard', 'Keyboard first', 'Rebindable shortcuts and a cheat sheet on the ? key.'],
  ['Languages', 'Light, dark, compact', 'Themes, density and English or Polish.'],
  ['ShieldCheck', 'No tracking', 'No analytics, no ads, no access to pages until you click.'],
] as const

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
}

const filmSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: 'TabHangar in under a minute',
  description:
    'A short film about the TabHangar browser extension: dragging tabs into groups, saving any page with a note, to-dos, search, collections, reminders, dark mode and sync through your own server.',
  thumbnailUrl: new URL('/promo-poster.jpg', Astro.site).toString(),
  contentUrl: new URL('/promo.mp4', Astro.site).toString(),
  uploadDate: '2026-10-08',
  duration: 'PT53S',
}
---

<Layout
  title="TabHangar — open-source tab manager with kanban boards and self-hosted sync"
  description="Turn your new tab into kanban boards for tabs, links, notes and to-dos. Free, open-source Chrome extension that works offline, with optional sync through your own server."
  schema={[faqSchema, filmSchema]}
>
  <Nav />
  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div class="hero-grid pointer-events-none absolute inset-0 -z-10"></div>
      <div class="pointer-events-none absolute inset-x-0 -top-48 -z-10 mx-auto h-[620px] max-w-5xl rounded-full bg-[radial-gradient(closest-side,rgb(124_108_246/0.30),transparent)] blur-2xl"></div>
      <div class="mx-auto max-w-6xl px-5 pt-16 pb-12 text-center sm:pt-24">
        <a
          href={releases}
          class="mx-auto mb-7 inline-flex items-center gap-2 rounded-full border border-line bg-card/70 py-1.5 pr-3 pl-1.5 text-[13.5px] font-medium shadow-tile backdrop-blur hover:bg-card"
          data-reveal
        >
          <span class="rounded-full bg-accent px-2 py-0.5 text-[12px] font-semibold text-on-accent">
            New
          </span>
          Self-hosted sync is here
          <Icon name="ArrowRight" size={14} class="text-ink-3" />
        </a>
        <h1
          class="mx-auto max-w-4xl text-[44px] leading-[1.02] font-semibold tracking-[-0.04em] text-balance sm:text-[72px]"
          data-reveal="0.05"
        >
          Your tabs, parked <span class="shimmer">calmly</span>
        </h1>
        <p
          class="mx-auto mt-6 max-w-2xl text-[18px] leading-relaxed text-balance text-ink-2 sm:text-[20px]"
          data-reveal="0.12"
        >
          An <span class="whitespace-nowrap">open-source</span> tab manager that turns the new tab
          page into kanban boards for tabs, links, notes and{' '}
          <span class="whitespace-nowrap">to-dos</span>. Works offline. Syncs through a server you
          own.
        </p>
        <div class="mt-9 flex flex-wrap items-center justify-center gap-3" data-reveal="0.2">
          <a
            href={releases}
            class="group flex h-12 items-center gap-2 rounded-xl bg-accent px-6 text-[15.5px] font-semibold text-on-accent shadow-glow transition hover:brightness-110"
          >
            <Icon name="Download" size={18} /> Get it for Chrome
          </a>
          <a
            href={repo}
            class="flex h-12 items-center gap-2 rounded-xl bg-card px-6 text-[15.5px] font-semibold shadow-tile transition hover:bg-raised"
          >
            <GitHubMark size={18} /> Star on GitHub
          </a>
          <PromoFilm />
        </div>
        <p class="mt-4 text-[13.5px] text-ink-3" data-reveal="0.25">
          Free & MIT licensed · Chrome, Edge, Brave · no account needed
        </p>
      </div>
      <div class="mx-auto max-w-6xl px-5 pb-28" data-reveal="0.3">
        <HeroDemo />
      </div>
    </section>

    <ChaosToCalm />

    <StickyShowcase />

    <DemoVideo />

    <!-- Feature grid -->
    <section id="features" class="scroll-mt-20 border-y border-line bg-panel/60 py-24">
      <div class="mx-auto max-w-6xl px-5">
        <h2
          class="text-center text-[34px] font-semibold tracking-[-0.03em] sm:text-[44px]"
          data-words
        >
          Small details, everywhere
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-center text-[17px] text-ink-2" data-reveal="0.05">
          Built by someone who keeps thirty tabs open “for later” — and wanted somewhere nice to put
          them.
        </p>
        <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-spotlight>
          {features.map(([icon, title, text], index) => (
            <article
              class="spotlight rounded-[18px] bg-card p-6 shadow-card"
              data-reveal={(index % 4) * 0.06}
            >
              <span class="flex size-11 items-center justify-center rounded-xl bg-accent-soft text-accent-ink">
                <Icon name={icon} size={21} />
              </span>
              <h3 class="mt-5 text-[16.5px] font-semibold tracking-[-0.01em]">{title}</h3>
              <p class="mt-2 text-[14.5px] leading-relaxed text-ink-2" set:html={nb(text)} />
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Self-host -->
    <section id="self-host" class="scroll-mt-20 py-28">
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 lg:grid-cols-2">
        <div data-reveal>
          <span class="text-[13px] font-semibold tracking-[0.08em] text-accent-ink uppercase">
            Self-hosted sync
          </span>
          <h2 class="mt-3 text-[34px] leading-tight font-semibold tracking-[-0.03em] sm:text-[42px]">
            Your server. Your data. Every browser in sync.
          </h2>
          <p class="mt-5 text-[16.5px] leading-relaxed text-ink-2">
            One small container with an SQLite database. Caddy gets the HTTPS certificate, a backup
            script keeps seven nightly copies, and changes reach your other computers in seconds.
          </p>
          <ul class="mt-6 flex flex-col gap-2.5 text-[15px] text-ink-2">
            {[
              'Login and password, sign-up off by default',
              'Live updates, offline edits merge when you reconnect',
              'Docker images for amd64 and arm64 (a Raspberry Pi is enough)',
              'No telemetry, no third-party services',
            ].map((point) => (
              <li class="flex items-start gap-2.5">
                <span class="mt-0.5 text-success">
                  <Icon name="Check" size={18} />
                </span>
                {point}
              </li>
            ))}
          </ul>
          <a
            href="/self-hosted-tab-manager"
            class="mt-8 inline-flex items-center gap-2 text-[15px] font-semibold text-accent-ink hover:underline"
          >
            How self-hosting works <Icon name="ArrowRight" size={16} />
          </a>
        </div>
        <div data-reveal="0.1">
          <Terminal />
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="scroll-mt-20 border-t border-line bg-panel/60 py-24">
      <div class="mx-auto max-w-3xl px-5">
        <h2
          class="text-center text-[34px] font-semibold tracking-[-0.03em] sm:text-[44px]"
          data-words
        >
          Questions, answered
        </h2>
        <div class="mt-12 flex flex-col gap-3">
          {faq.map((item, index) => (
            <details
              class="group rounded-[16px] bg-card px-5 py-4 shadow-tile open:shadow-card"
              data-reveal={index * 0.04}
            >
              <summary class="flex list-none items-center justify-between gap-4 text-[16px] font-semibold [&::-webkit-details-marker]:hidden">
                {item.q}
                <span class="text-ink-3 transition-transform duration-200 group-open:rotate-45">
                  <Icon name="Plus" size={18} />
                </span>
              </summary>
              <p
                class="mt-3 text-[15px] leading-relaxed text-ink-2"
                set:html={item.html ?? nb(item.a)}
              />
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Call to action -->
    <section class="relative overflow-hidden py-28 text-center">
      <div class="pointer-events-none absolute inset-x-0 bottom-[-260px] -z-10 mx-auto h-[520px] max-w-4xl rounded-full bg-[radial-gradient(closest-side,rgb(124_108_246/0.25),transparent)] blur-2xl"></div>
      <div class="mx-auto max-w-3xl px-5" data-reveal>
        <h2
          class="text-[36px] leading-tight font-semibold tracking-[-0.035em] sm:text-[52px]"
          data-words
        >
          Close the tabs.
          <br />
          Keep the thoughts.
        </h2>
        <p class="mx-auto mt-5 max-w-xl text-[17px] text-ink-2">
          Free and open source. Install it in a minute, sync it when you are ready.
        </p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <a
            href={releases}
            class="flex h-12 items-center gap-2 rounded-xl bg-accent px-6 text-[15.5px] font-semibold text-on-accent shadow-glow transition hover:brightness-110"
          >
            <Icon name="Download" size={18} /> Get it for Chrome
          </a>
          <a
            href="/alternatives/"
            class="flex h-12 items-center gap-2 rounded-xl bg-card px-6 text-[15.5px] font-semibold shadow-tile transition hover:bg-raised"
          >
            Compare with other tab managers
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
