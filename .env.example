# Copy to .env and adjust. Used by docker-compose.yml.

# Domain pointing at this server (DNS A/AAAA record); Caddy gets a certificate for it.
DOMAIN=tabs.example.com

# First account, created on the first start when there are no users.
# Remove the password from this file after the first start.
ADMIN_USERNAME=michal
ADMIN_PASSWORD=change-me-to-a-long-password

# Let anyone with the address create an account (true/false).
ALLOW_SIGNUP=false

# Days a device stays signed in without being used.
SESSION_TTL_DAYS=30
