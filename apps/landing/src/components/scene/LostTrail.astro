---
/**
 * The 404 scene: a signpost made of browser tabs at the edge of the forest, a lantern, and the
 * trail down to the cabin. The signs are real links. Morning in the light theme, night in the
 * dark one.
 */
import {
  forest,
  type Ground,
  land,
  mountains,
  round,
  ridge,
  seeded,
  spruce,
} from '../../lib/landscape'
import Cabin from './Cabin.astro'
import TabSign from './TabSign.astro'

const width = 1280
const height = 800
const rand = seeded(404)
const post = 600
const cabinX = 900
// Wider screens see more of the valley, not a closer and cropped view: the drawing reaches 1440
// units either side of its middle, so up to 32:9 it scales with the screen height and the
// signpost stays clear of the heading.
const centre = 605
const reach = 1440
const left = centre - reach
const right = centre + reach

const range = mountains(
  [
    [-20, 470],
    [120, 420],
    [260, 452],
    [420, 400],
    [560, 446],
    [700, 424],
    [860, 380],
    [1000, 428],
    [1140, 396],
    [1300, 440],
  ],
  height,
  rand,
)
const farRow = { gap: 12, min: 16, max: 34 }
const farGround = ridge({ base: 482, amp: 8, phase: 1.4 })
const far = forest({ width, bottom: height, y: farGround, rand, ...farRow })
const cabinY = ridge({ base: 522, amp: 10, phase: 2.2 })(cabinX)
const middleRow = { gap: 18, min: 28, max: 58 }
const middleGround = ridge({
  base: 522,
  amp: 10,
  phase: 2.2,
  pin: { x: cabinX, y: cabinY, reach: 70 },
})
const middle = forest({
  width,
  bottom: height,
  y: middleGround,
  rand,
  ...middleRow,
  skip: (x) => Math.abs(x - cabinX) < 42,
})
const meadow = land(ridge({ base: 556, amp: 6, phase: 0.3 }), right, height, left - 60)
const saplings = [
  [452, 708, 46],
  [486, 716, 30],
  [740, 690, 40],
  [1010, 640, 52],
  [1050, 652, 34],
  [230, 650, 44],
  [-120, 700, 40],
  [-196, 676, 28],
  [-560, 690, 46],
  [1400, 690, 44],
  [1440, 712, 30],
  [1780, 700, 42],
]
  .map(([x, y, tall]) => spruce(x!, y!, tall!, tall! * 0.44))
  .join('')
const front = [
  // The left ones stay below the button on short, wide screens.
  [-40, 370],
  [40, 290],
  [112, 210],
  [1180, 270],
  [1240, 390],
  [1312, 470],
  // Further out, for wide screens.
  [-250, 250],
  [-330, 360],
  [-420, 470],
  [-640, 300],
  [-760, 440],
  [1480, 250],
  [1560, 360],
  [1650, 460],
  [1860, 320],
  [1980, 450],
]
  .map(([x, tall]) => spruce(x!, 822, tall!, tall! * 0.42))
  .join('')
const fireflies = Array.from({ length: 16 }, () => ({
  x: round(rand() < 0.5 ? 200 + rand() * 300 : 960 + rand() * 260),
  y: round(600 + rand() * 140),
  delay: `${(-rand() * 9).toFixed(1)}s, ${(-rand() * 3).toFixed(1)}s`,
}))
const nails = [421, 483, 545]

// The parts beyond the first view come last, so the middle keeps the same trees and peaks.
const rangeWings =
  mountains(
    [
      [left - 20, 452],
      [-760, 414],
      [-650, 440],
      [-520, 396],
      [-400, 436],
      [-290, 408],
      [-150, 446],
      [-20, 470],
    ],
    height,
    rand,
  ) +
  mountains(
    [
      [1300, 440],
      [1420, 404],
      [1540, 430],
      [1660, 388],
      [1790, 428],
      [1910, 400],
      [right + 20, 444],
    ],
    height,
    rand,
  )
/** A row's ground across the whole drawing and its trees on both sides of the first view. */
const wings = (y: Ground, row: { gap: number; min: number; max: number }) =>
  land(y, right, height, left - 60) +
  forest({ width, bottom: height, y, rand, ...row, from: left, to: -30, ground: false }) +
  forest({ width, bottom: height, y, rand, ...row, from: width + 30, to: right, ground: false })
const farWings = wings(farGround, farRow)
const middleWings = wings(middleGround, middleRow)
---

<!--
  On a phone the drawing keeps a fixed small scale (806 × 504), wide enough for the signpost and
  the cabin; from the small breakpoint up it fills the scene, which is as tall as the screen.
-->
<svg
  class="absolute bottom-0 left-1/2 -ml-[450px] h-[504px] w-[806px] sm:inset-0 sm:ml-0 sm:h-full sm:w-full"
  viewBox={`${left} 0 ${2 * reach} ${height}`}
  preserveAspectRatio="xMidYMax slice"
  role="group"
  aria-label="A signpost made of browser tabs"
>
  <defs>
    <linearGradient id="lost-mist" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--scene-sky-bottom); stop-opacity: 0"></stop>
      <stop offset="1" style="stop-color: var(--scene-sky-bottom); stop-opacity: 0.85"></stop>
    </linearGradient>
    <radialGradient id="lost-firefly">
      <stop offset="0" stop-color="#F4EAD5" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#F4EAD5" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="lost-lamp">
      <stop offset="0" stop-color="#F4EAD5" stop-opacity="0.4"></stop>
      <stop offset="0.45" stop-color="#F4EAD5" stop-opacity="0.16"></stop>
      <stop offset="1" stop-color="#F4EAD5" stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  <g class="scene-sun">
    <circle cx="1080" cy="404" r="86" opacity="0.35" style="fill: var(--scene-sun)"></circle>
    <circle cx="1080" cy="404" r="54" style="fill: var(--scene-sun)"></circle>
  </g>
  <path d={range + rangeWings} style="fill: var(--scene-mountain)"></path>
  <rect x={left} y="420" width={2 * reach} height="80" fill="url(#lost-mist)"></rect>
  <path d={far + farWings} style="fill: var(--scene-far)"></path>
  <rect x={left} y="470" width={2 * reach} height="60" fill="url(#lost-mist)" opacity="0.7"></rect>
  <path d={middle + middleWings} style="fill: var(--scene-middle)"></path>
  <Cabin x={cabinX} y={Math.round(cabinY + 1)} scale={1.6} id="lost-cabin" />
  <path d={meadow} style="fill: var(--scene-near)"></path>
  <path
    d="M700 800 C 760 710, 860 630, 906 560 L 924 560 C 916 640, 900 720, 930 800 Z"
    style="fill: var(--scene-path)"
    opacity="0.85"
  ></path>

  <!-- Lantern light on the grass: soft by day, warm at night. -->
  <ellipse
    cx="540"
    cy="706"
    rx="250"
    ry="52"
    fill="url(#lost-lamp)"
    style="opacity: calc(0.3 + var(--scene-night) * 0.7)"
  ></ellipse>
  <path d={saplings} style="fill: var(--scene-front)"></path>

  <!-- The post. -->
  <ellipse cx={post} cy="704" rx="44" ry="8" style="fill: var(--scene-front)"></ellipse>
  <rect x={post - 8} y="372" width="16" height="334" rx="3" style="fill: var(--scene-post)"></rect>
  <path d={`M${post - 10} 374 h20 l-10 -16 z`} style="fill: var(--scene-post)"></path>

  <TabSign
    href="/"
    label="Home"
    x={post + 16}
    y={398}
    width={200}
    tilt={-3}
    nail={[post, nails[0]!]}
    arrow="right"
  />
  <TabSign
    href="/#features"
    label="Features"
    x={post - 206}
    y={460}
    width={190}
    tilt={2.5}
    nail={[post, nails[1]!]}
    arrow="left"
  />
  <TabSign
    href="/self-hosted-tab-manager/"
    label="Self-host"
    x={post + 16}
    y={522}
    width={200}
    tilt={-1.5}
    nail={[post, nails[2]!]}
    arrow="right"
  />
  {nails.map((y) => (
    <circle cx={post} cy={y} r="3" class="fill-ink-3" />
  ))}

  <!-- The 404 tab lost a nail and hangs by one string. -->
  <g class="lost-hanging" style={`transform-origin: ${post}px 598px`}>
    <g transform={`rotate(12 ${post} 598)`}>
      <path d={`M${post} 598 L${post - 44} 614`} stroke-width="1.5" class="stroke-ink-3"></path>
      <rect
        x={post - 58}
        y="619"
        width="116"
        height="38"
        rx="10"
        fill="#0F1110"
        opacity="0.14"
      ></rect>
      <rect x={post - 58} y="614" width="116" height="38" rx="10" fill="#E9DFC6"></rect>
      <text x={post} y="639.5" text-anchor="middle" class="lost-404">
        404
      </text>
    </g>
  </g>
  <circle cx={post} cy="598" r="3" class="fill-ink-3"></circle>

  <!-- Lantern on a bracket. -->
  <path
    d={`M${post} 386 H${post - 68} V398`}
    fill="none"
    stroke-width="5"
    stroke-linecap="round"
    style="stroke: var(--scene-post)"
  ></path>
  <g transform={`translate(${post - 68} 0)`}>
    <circle
      cx="0"
      cy="424"
      r="120"
      fill="url(#lost-lamp)"
      style="opacity: calc(0.35 + var(--scene-night) * 0.65)"
    ></circle>
    <path d="M-12 402 h24 l-4 -6 h-16 z" style="fill: var(--scene-post)"></path>
    <rect
      x="-10"
      y="402"
      width="20"
      height="30"
      rx="4"
      fill="#F4EAD5"
      style="filter: drop-shadow(0 0 8px #F4EAD5)"
    ></rect>
    <path d="M-10 417 h20 M0 402 v30" stroke="#C9B98F" stroke-width="1.2"></path>
    <rect x="-12" y="432" width="24" height="5" rx="1.5" style="fill: var(--scene-post)"></rect>
  </g>

  <g class="scene-by-night">
    {fireflies.map((fly) => (
      <g transform={`translate(${fly.x} ${fly.y})`}>
        <g class="scene-firefly" style={`animation-delay:${fly.delay}`}>
          <circle r="7" fill="url(#lost-firefly)" />
          <circle r="1.8" fill="#EEF3C9" />
        </g>
      </g>
    ))}
  </g>
  <path d={front} style="fill: var(--scene-front)"></path>
</svg>

<style>
  .lost-404 {
    fill: #1f4a3a;
    font:
      700 17px 'Bricolage Grotesque Variable',
      system-ui,
      sans-serif;
  }
  .lost-hanging {
    animation: lost-sway 3.4s ease-in-out infinite alternate;
  }
  @keyframes lost-sway {
    from {
      transform: rotate(-3deg);
    }
    to {
      transform: rotate(4deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lost-hanging {
      animation: none;
    }
  }
</style>
