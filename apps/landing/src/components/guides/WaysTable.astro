---
/**
 * The ways a guide describes, side by side: a table on wider screens and one small card per way on
 * phones, where four columns do not fit.
 */
interface Props {
  caption: string
  /** Headings of the columns after the first one (the way itself). */
  columns: string[]
  /** One row per way: its name, then a cell for each column. */
  rows: string[][]
}

const { caption, columns, rows } = Astro.props
---

<ul class="mt-6 flex flex-col gap-3 sm:hidden">
  {rows.map(([way, ...cells]) => (
    <li class="!mt-0 rounded-[18px] bg-card p-5 shadow-card">
      <p class="!mt-0 font-semibold text-ink">{way}</p>
      <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[14.5px]">
        {cells.map((cell, index) => (
          <>
            <dt class="text-ink-3">{columns[index]}</dt>
            <dd>{cell}</dd>
          </>
        ))}
      </dl>
    </li>
  ))}
</ul>
<div class="mt-6 hidden overflow-hidden rounded-[18px] bg-card shadow-card sm:block">
  <table class="w-full text-left text-[14.5px]">
    <caption class="sr-only">{caption}</caption>
    <thead class="bg-subtle text-[13px] text-ink-2">
      <tr>
        <th class="px-4 py-3 font-semibold" scope="col">
          Way
        </th>
        {columns.map((column) => (
          <th class="px-4 py-3 font-semibold" scope="col">
            {column}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map(([way, ...cells]) => (
        <tr class="border-t border-line">
          <th class="px-4 py-3 font-medium text-ink" scope="row">
            {way}
          </th>
          {cells.map((cell) => (
            <td class="px-4 py-3">{cell}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
