---
/**
 * A group someone shared from TabCabin. The link names it after the # (so the id never reaches
 * this site's logs or visit counts); the page reads the group from the sync server (SYNC_URL),
 * always as it is now.
 */
import Footer from '../../components/Footer.astro'
import GetExtension from '../../components/GetExtension.astro'
import Icon from '../../components/Icon.astro'
import Nav from '../../components/Nav.astro'
import Layout from '../../layouts/Layout.astro'
import { extensionId, syncUrl } from '../../site'

const messages = [
  {
    state: 'gone',
    sign: '🍂',
    title: 'This link no longer works',
    text: 'Its owner stopped sharing the group, or deleted it.',
  },
  {
    state: 'missing',
    sign: '🧭',
    title: 'Which group?',
    text: 'This link is missing its end. Open the whole link you were sent.',
  },
  {
    state: 'failed',
    sign: '🌧️',
    title: 'The group didn’t load',
    text: 'Check your connection and try again in a moment.',
  },
  {
    state: 'unavailable',
    sign: '🧭',
    title: 'Shared groups don’t open here',
    text: 'This copy of the website isn’t connected to a sync server.',
  },
]
const card = 'rounded-[22px] bg-card p-3.5 shadow-card'
// The page fills one screen with the forest at its bottom edge (the menu is 4rem, the forest as tall
// as in the footer); a long group scrolls inside its card instead of stretching the page.
const screen = 'height: max(26rem, calc(100svh - 4rem - clamp(110px, 15.6vw, 200px)))'
---

<Layout
  title="A shared group · TabCabin"
  description="A group of links, notes and to-dos shared from TabCabin."
  path="/s/"
  noindex
>
  <Nav />
  <main
    class="mx-auto flex max-w-2xl flex-col px-5 pt-10 pb-6 sm:pt-14"
    style={screen}
    data-shared
    data-sync={syncUrl}
    data-extension={extensionId}
  >
    <div data-state="loading" aria-busy="true" aria-label="Loading the group">
      <div class="flex items-center gap-4">
        <span class="size-12 animate-pulse rounded-[14px] bg-subtle"></span>
        <span class="flex flex-col gap-2.5">
          <span class="h-6 w-56 animate-pulse rounded-lg bg-subtle"></span>
          <span class="h-3.5 w-40 animate-pulse rounded-md bg-subtle"></span>
        </span>
      </div>
      <div class:list={[card, 'mt-7 flex flex-col gap-1.5']}>
        {[0, 1, 2, 3].map(() => (
          <span class="flex items-center gap-3 p-2">
            <span class="size-9 animate-pulse rounded-[10px] bg-subtle" />
            <span class="h-4 flex-1 animate-pulse rounded-md bg-subtle" />
          </span>
        ))}
      </div>
    </div>

    <section class="flex min-h-0 flex-1 flex-col" data-state="group" hidden>
      <div class="flex min-w-0 items-center gap-4">
        <span class="text-[46px] leading-none" aria-hidden="true" data-emoji></span>
        <div class="min-w-0">
          <h1
            class="font-display text-[30px] leading-tight font-semibold tracking-[-0.03em] break-words sm:text-[36px]"
            data-title
          ></h1>
          <p class="mt-1 text-[14.5px] text-ink-3" data-meta></p>
        </div>
      </div>
      <!-- Get TabCabin, or Import once the extension answers (shared/importButton.ts). -->
      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2">
        <div data-get>
          <GetExtension label="Get TabCabin" size="md" />
        </div>
        <div data-import hidden>
          <button
            type="button"
            data-umami-event="Import shared group"
            class="inline-flex h-11 items-center gap-2 rounded-xl bg-accent px-5 text-[15px] font-semibold text-on-accent shadow-tile transition hover:brightness-110 disabled:opacity-60"
          >
            <Icon name="Plus" size={17} /> Import to your TabCabin
          </button>
        </div>
        <p class="text-[14.5px] text-accent-ink" aria-live="polite" data-import-status></p>
      </div>
      <div class="relative mt-7 flex min-h-0 flex-col overflow-hidden rounded-[22px] bg-card shadow-card">
        <!-- While more rows wait below, the last one fades out and "More below" shows (data-more). -->
        <ul
          class="flex min-h-0 flex-col gap-1.5 overflow-y-auto overscroll-contain p-3.5 [scrollbar-color:var(--color-line)_transparent] [scrollbar-width:thin] data-[more]:[mask-image:linear-gradient(to_bottom,black_calc(100%-88px),transparent_calc(100%-8px))]"
          data-items
        ></ul>
        <button
          type="button"
          class="absolute bottom-3.5 left-1/2 flex h-9 -translate-x-1/2 items-center gap-1.5 rounded-full bg-card px-4 text-[13.5px] font-semibold text-ink-2 shadow-tile transition hover:text-ink"
          data-more-below
          hidden
        >
          More below <Icon name="ChevronDown" size={16} />
        </button>
      </div>
      <p class="mt-5 shrink-0 text-center text-[13.5px] text-ink-3">
        Shared from TabCabin · read only
      </p>
    </section>

    {messages.map((message) => (
      <section data-state={message.state} hidden>
        <div class="mx-auto max-w-md pt-[6vh] text-center">
          <div class="text-[56px] leading-none" aria-hidden="true">
            {message.sign}
          </div>
          <h1 class="mt-5 font-display text-[30px] leading-tight font-semibold tracking-[-0.03em]">
            {message.title}
          </h1>
          <p class="mt-3 text-[16.5px] leading-relaxed text-ink-2">{message.text}</p>
          <div class="mt-7 flex flex-wrap justify-center gap-3">
            {message.state === 'failed' && (
              <button
                type="button"
                class="inline-flex h-11 items-center rounded-xl bg-accent px-5 text-[15px] font-semibold text-on-accent shadow-tile transition hover:brightness-110"
                data-retry
              >
                Try again
              </button>
            )}
            <a
              href="/"
              class="inline-flex h-11 items-center rounded-xl bg-card px-5 text-[15px] font-semibold shadow-tile transition hover:bg-raised"
            >
              Go to TabCabin
            </a>
          </div>
        </div>
      </section>
    ))}
  </main>
  <Footer />
</Layout>

<script>
  import { offerImport } from '../../components/shared/importButton'
  import { loadShared } from '../../components/shared/load'
  import { groupMeta, groupRows } from '../../components/shared/render'

  const root = document.querySelector<HTMLElement>('[data-shared]')!
  const show = (state: string) => {
    for (const part of root.querySelectorAll<HTMLElement>('[data-state]'))
      part.hidden = part.dataset.state !== state
  }
  const slot = (name: string) => root.querySelector<HTMLElement>(`[data-${name}]`)!

  async function open() {
    const server = root.dataset.sync
    const id = location.hash.slice(1).trim()
    if (!server) return show('unavailable')
    if (!/^[\w-]{8,64}$/.test(id)) return show('missing')
    show('loading')
    const loaded = await loadShared(server, id)
    if (loaded.status !== 'ok') return show(loaded.status)
    const { group } = loaded
    slot('emoji').textContent = group.emoji
    slot('title').textContent = group.title
    slot('meta').textContent = groupMeta(group)
    const rows = groupRows(group)
    const items = slot('items')
    if (rows.length) items.replaceChildren(...rows)
    else
      items.replaceChildren(
        Object.assign(document.createElement('li'), {
          className: 'p-6 text-center text-ink-3',
          textContent: 'Nothing here yet.',
        }),
      )
    document.title = `${`${group.emoji} ${group.title}`.trim()} · TabCabin`
    show('group')
    showMore()
    offerImport(root, id)
  }

  const list = slot('items')
  const moreBelow = slot('more-below')
  const showMore = () => {
    const more = list.scrollTop + list.clientHeight < list.scrollHeight - 4
    list.toggleAttribute('data-more', more)
    moreBelow.hidden = !more
  }
  list.addEventListener('scroll', showMore, { passive: true })
  addEventListener('resize', showMore)
  moreBelow.addEventListener('click', () =>
    list.scrollBy({ top: list.clientHeight * 0.75, behavior: 'smooth' }),
  )

  root.querySelector('[data-retry]')?.addEventListener('click', () => void open())
  addEventListener('hashchange', () => void open())
  void open()
</script>
