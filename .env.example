# Copy to .env and adjust. Used by docker-compose.yml.

# Domain pointing at this server (DNS A/AAAA record); Caddy gets a certificate for it.
DOMAIN=tabs.example.com

# First account, created on the first start when there are no users.
# Remove the password from this file after the first start.
ADMIN_USERNAME=michal
ADMIN_PASSWORD=change-me-to-a-long-password

# Let anyone create an account (with a password or Google). true for a public server.
ALLOW_SIGNUP=false

# Sign in with Google (optional). Create an OAuth client in Google Cloud with the redirect
# address https://<DOMAIN>/auth/google/callback; see docs/self-hosting.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# With ALLOW_SIGNUP=false: Google addresses that may still join (full addresses or @domain).
SIGNUP_EMAILS=

# Anti-abuse limits. MAX_USERS=0 means no limit on the number of accounts.
MAX_USERS=0
SIGNUPS_PER_IP_PER_DAY=5
MAX_RECORDS_PER_USER=100000

# Discord webhook that receives the extension's feedback form (empty: the form is off).
FEEDBACK_WEBHOOK_URL=
FEEDBACK_PER_IP_PER_DAY=5

# Days a device stays signed in without being used.
SESSION_TTL_DAYS=30
