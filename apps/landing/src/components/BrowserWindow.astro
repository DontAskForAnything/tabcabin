---
/**
 * A Chrome window around a screenshot, like the one in the film: tab strip, toolbar and address
 * bar, light or dark with the site's theme. Its parts scale with the window's width.
 *
 * The tab and the address bar can be switched from script through the `data-browser-*` hooks
 * (see StickyShowcase).
 */
import Logo from './Logo.astro'

interface Props {
  /** "newtab" shows TabCabin's new tab; "article" a web page with the given address. */
  page?: 'newtab' | 'article'
  title?: string
  url?: string
  class?: string
}
const { page = 'newtab', title, url, class: className = '' } = Astro.props
const newtab = page === 'newtab'
---

<div class:list={['browser', className]} data-browser>
  <div class="browser-strip">
    <span class="browser-lights" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span class="browser-tab">
      <span class="browser-icon" data-browser-icon="newtab" hidden={!newtab}>
        <Logo size={16} />
      </span>
      <span class="browser-icon" data-browser-icon="article" hidden={newtab}>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path>
        </svg>
      </span>
      <span class="browser-title" data-browser-title>
        {title ?? 'New Tab'}
      </span>
      <span class="browser-x" aria-hidden="true">
        ×
      </span>
    </span>
    <span class="browser-new" aria-hidden="true">
      +
    </span>
  </div>
  <div class="browser-toolbar" aria-hidden="true">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    >
      <path d="M19 12H5M12 19l-7-7 7-7"></path>
    </svg>
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      class="opacity-45"
    >
      <path d="M5 12h14M12 5l7 7-7 7"></path>
    </svg>
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    >
      <path d="M21 12a9 9 0 1 1-3-6.7L21 8"></path>
      <path d="M21 3v5h-5"></path>
    </svg>
    <span class="browser-omnibox">
      <span class="browser-url" data-browser-url>
        {url ?? <span class="opacity-70">Search Google or type a URL</span>}
      </span>
    </span>
    <span class="browser-ext">
      <Logo size={16} />
    </span>
    <span class="browser-avatar">M</span>
  </div>
  <div class="browser-screen">
    <slot />
  </div>
</div>

<style>
  .browser {
    --strip: #dee1e6;
    --surface: #ffffff;
    --omnibox: #f1f3f4;
    --text: #1f1f1f;
    --muted: #5f6368;
    container-type: inline-size;
    overflow: hidden;
    border-radius: clamp(10px, 1.1cqw, 16px);
    background: var(--strip);
    box-shadow:
      var(--shadow-pop),
      0 0 0 1px var(--line);
  }
  :global(.dark) .browser {
    --strip: #1f2023;
    --surface: #35363a;
    --omnibox: #202124;
    --text: #e8eaed;
    --muted: #9aa0a6;
  }
  .browser-strip {
    display: flex;
    height: clamp(24px, 3cqw, 42px);
    align-items: flex-end;
    padding-left: clamp(8px, 1.1cqw, 16px);
  }
  .browser-lights {
    display: flex;
    gap: clamp(4px, 0.55cqw, 8px);
    align-self: center;
    margin-right: clamp(8px, 1.2cqw, 18px);
  }
  .browser-lights i {
    width: clamp(7px, 0.85cqw, 12px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: #ff5f57;
  }
  .browser-lights i:nth-child(2) {
    background: #febc2e;
  }
  .browser-lights i:nth-child(3) {
    background: #28c840;
  }
  .browser-tab {
    display: flex;
    width: clamp(120px, 17cqw, 250px);
    height: 82%;
    align-items: center;
    gap: clamp(5px, 0.6cqw, 9px);
    padding: 0 clamp(7px, 0.8cqw, 12px);
    border-radius: clamp(6px, 0.7cqw, 10px) clamp(6px, 0.7cqw, 10px) 0 0;
    background: var(--surface);
    color: var(--text);
    font-size: clamp(9.5px, 0.9cqw, 13px);
  }
  .browser-icon {
    display: flex;
    width: clamp(11px, 1.1cqw, 16px);
    height: clamp(11px, 1.1cqw, 16px);
    flex: none;
    color: var(--muted);
  }
  .browser-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .browser-icon[hidden] {
    display: none;
  }
  .browser-title {
    flex: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .browser-x,
  .browser-new {
    color: var(--muted);
    font-size: clamp(11px, 1.15cqw, 17px);
    line-height: 1;
  }
  .browser-new {
    align-self: center;
    margin-left: clamp(8px, 1cqw, 14px);
  }
  .browser-toolbar {
    display: flex;
    height: clamp(26px, 3.2cqw, 46px);
    align-items: center;
    gap: clamp(8px, 1.1cqw, 16px);
    padding: 0 clamp(8px, 1cqw, 14px);
    background: var(--surface);
    border-bottom: 1px solid color-mix(in srgb, var(--muted) 22%, transparent);
    color: var(--muted);
  }
  .browser-toolbar > svg {
    width: clamp(11px, 1.25cqw, 18px);
    height: clamp(11px, 1.25cqw, 18px);
    flex: none;
  }
  .browser-omnibox {
    display: flex;
    min-width: 0;
    flex: 1;
    height: 74%;
    align-items: center;
    padding: 0 clamp(8px, 1cqw, 14px);
    border-radius: 999px;
    background: var(--omnibox);
    color: var(--text);
    font-size: clamp(9.5px, 0.97cqw, 14px);
  }
  .browser-url {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .browser-ext {
    display: flex;
    width: clamp(12px, 1.4cqw, 20px);
    flex: none;
  }
  .browser-ext :global(svg) {
    width: 100%;
    height: auto;
  }
  .browser-avatar {
    display: flex;
    width: clamp(16px, 1.8cqw, 26px);
    aspect-ratio: 1;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #1f4a3a;
    color: #faf6ee;
    font-size: clamp(8px, 0.8cqw, 12px);
    font-weight: 600;
  }
  .browser-screen {
    position: relative;
    background: var(--canvas);
  }
</style>
