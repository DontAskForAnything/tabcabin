---
import '../styles/global.css'

interface Props {
  title: string
  description: string
  /** Path of the page, for the canonical link. */
  path?: string
  /** Extra JSON-LD objects (FAQ, breadcrumbs…). */
  schema?: object[]
  /** Breadcrumb trail for subpages: [name, path][]. */
  breadcrumbs?: [string, string][]
}

const { title, description, path = '/', schema = [], breadcrumbs } = Astro.props
const canonical = new URL(path, Astro.site)
const ogImage = new URL('/og.png', Astro.site)
import { repo } from '../site'
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'TabHangar',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'Chrome, Edge, Brave',
  description,
  url: Astro.site?.toString(),
  license: 'https://opensource.org/licenses/MIT',
  codeRepository: repo,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#eceff4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0e11" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TabHangar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {schema.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    {breadcrumbs && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'BreadcrumbList',
          itemListElement: [['Home', '/'], ...breadcrumbs].map(([name, itemPath], index) => ({
            '@type': 'ListItem',
            position: index + 1,
            name,
            item: new URL(itemPath, Astro.site).toString(),
          })),
        })}
      />
    )}

    <!-- Apply the saved or system theme before the first paint. -->
    <script is:inline>
      ;(() => {
        let theme = null
        try {
          theme = localStorage.getItem('theme')
        } catch {}
        const dark = theme ? theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches
        document.documentElement.classList.toggle('dark', dark)
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
          document.documentElement.classList.add('motion-ok')
      })()
    </script>
  </head>
  <body class="min-h-screen">
    <slot />
    <script>
      import { animate, inView } from 'motion'

      // Fade sections in as they scroll into view (only when motion is welcome).
      if (document.documentElement.classList.contains('motion-ok')) {
        document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
          inView(
            el,
            () => {
              void animate(
                el,
                { opacity: [0, 1], y: [22, 0] },
                { duration: 0.7, delay: Number(el.dataset.reveal || 0), ease: [0.2, 0.7, 0.2, 1] },
              )
            },
            { amount: 0.25 },
          )
        })
      }

      // Headings marked with data-words rise word by word.
      if (document.documentElement.classList.contains('motion-ok')) {
        document.querySelectorAll<HTMLElement>('[data-words]').forEach((heading) => {
          const walker = document.createTreeWalker(heading, NodeFilter.SHOW_TEXT)
          const texts: Text[] = []
          while (walker.nextNode()) texts.push(walker.currentNode as Text)
          for (const text of texts) {
            const fragment = document.createDocumentFragment()
            for (const part of text.data.split(/(\s+)/)) {
              if (!part.trim()) {
                fragment.append(part)
                continue
              }
              const word = document.createElement('span')
              word.className = 'inline-block will-change-transform'
              word.style.opacity = '0'
              word.textContent = part
              fragment.append(word)
            }
            text.replaceWith(fragment)
          }
          const words = heading.querySelectorAll<HTMLElement>('span.inline-block')
          inView(
            heading,
            () => {
              words.forEach((word, i) => {
                void animate(
                  word,
                  { opacity: [0, 1], y: [24, 0], filter: ['blur(6px)', 'blur(0px)'] },
                  { duration: 0.6, delay: i * 0.07, ease: [0.2, 0.7, 0.2, 1] },
                )
              })
            },
            { amount: 0.6 },
          )
        })
      }

      // Soft light that follows the cursor over cards.
      document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((area) => {
        area.addEventListener('pointermove', (event) => {
          for (const card of area.querySelectorAll<HTMLElement>('.spotlight')) {
            const box = card.getBoundingClientRect()
            card.style.setProperty('--x', `${event.clientX - box.left}px`)
            card.style.setProperty('--y', `${event.clientY - box.top}px`)
          }
        })
      })
    </script>
  </body>
</html>
