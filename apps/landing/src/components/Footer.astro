---
import { repo, selfHostingGuide } from '../site'
import Logo from './Logo.astro'
import Etching from './scene/Etching.astro'

interface Props {
  /** The etched forest above the footer (off where the page already has its own scene). */
  scenery?: boolean
}
const { scenery = true } = Astro.props
---

<footer>
  {scenery && (
    <div class="h-[clamp(110px,15.6vw,200px)]">
      <Etching />
    </div>
  )}
  <div class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-10 text-[14px] text-ink-3 sm:flex-row sm:items-center">
      <div class="flex items-center gap-2.5 font-display text-[16px] font-bold tracking-[-0.02em] text-ink">
        <Logo size={24} />
        TabCabin
      </div>
      <p class="sm:flex-1">Open source under the MIT license · © 2026 Michał</p>
      <div class="flex gap-5">
        <a href={repo} class="hover:text-ink">
          GitHub
        </a>
        <a href={selfHostingGuide} class="hover:text-ink">
          Self-hosting
        </a>
        <a href="/privacy" class="hover:text-ink">
          Privacy
        </a>
        <a href="/third-party-licenses.txt" class="hover:text-ink">
          Licenses
        </a>
      </div>
    </div>
  </div>
</footer>
