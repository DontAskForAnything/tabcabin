{
  "name": "tabcabin",
  "private": true,
  "version": "1.4.2",
  "description": "Self-hosted tab manager: kanban boards and collections for your tabs, notes and to-dos.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DontAskForAnything/tabcabin.git"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:ext": "pnpm --filter @tabcabin/extension dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "build:ext": "pnpm --filter @tabcabin/extension build",
    "zip:ext": "pnpm --filter @tabcabin/extension zip",
    "e2e": "pnpm --filter @tabcabin/server build && pnpm --filter @tabcabin/extension build:e2e && pnpm --filter @tabcabin/extension e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
