---
import type { Template } from '@tabcabin/core'
import MiniBoard from './MiniBoard.astro'

interface Props {
  template: Template
  reveal?: number
}

const { template, reveal = 0 } = Astro.props
const items = template.groups.reduce((sum, group) => sum + group.items.length, 0)
---

<a
  href={`/templates/${template.id}/`}
  class="group flex flex-col rounded-[18px] bg-card p-2 pb-5 shadow-card transition-transform hover:-translate-y-0.5"
  data-reveal={reveal}
>
  <MiniBoard template={template} />
  <span class="mt-4 flex items-center gap-2 px-3 text-[18px] font-semibold">
    <span aria-hidden="true">{template.emoji}</span>
    {template.name.en}
  </span>
  <span class="mt-1.5 flex-1 px-3 text-[14px] leading-relaxed text-ink-2">
    {template.summary.en}
  </span>
  <span class="mt-3 px-3 font-mono text-[12px] text-accent-ink">
    {template.groups.length} groups · {items} to start with
  </span>
</a>
