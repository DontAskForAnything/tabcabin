---
import GitHubMark from './GitHubMark.astro'
import Icon from './Icon.astro'
import Logo from './Logo.astro'
import { repo } from '../site'
---

<!-- Clear over the page at the top; gets its own background once the page scrolls. -->
<header
  class="sticky top-0 z-30 border-b border-transparent transition-[background-color,border-color] duration-300 data-[scrolled]:border-line/70 data-[scrolled]:bg-canvas/80 data-[scrolled]:backdrop-blur-xl"
  data-nav
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5" aria-label="Main">
    <a
      href="/"
      class="flex items-center gap-2.5 font-display text-[19px] font-bold tracking-[-0.02em]"
    >
      <Logo size={30} />
      TabCabin
    </a>
    <div class="hidden flex-1 items-center gap-6 text-[14.5px] text-ink-2 md:flex">
      <a href="/#features" class="hover:text-ink">
        Features
      </a>
      <a href="/templates/" class="hover:text-ink">
        Templates
      </a>
      <a href="/#self-host" class="hover:text-ink">
        Self-host
      </a>
      <a href="/#faq" class="hover:text-ink">
        FAQ
      </a>
    </div>
    <div class="ml-auto flex items-center gap-2">
      <button
        type="button"
        id="theme-toggle"
        aria-label="Toggle dark mode"
        class="flex size-9 items-center justify-center rounded-[10px] text-ink-2 hover:bg-subtle hover:text-ink"
      >
        <Icon name="Moon" size={18} class="dark:hidden" />
        <Icon name="Sun" size={18} class="hidden dark:block" />
      </button>
      {repo && (
        <a
          href={repo}
          data-umami-event="GitHub"
          class="flex h-9 items-center gap-2 rounded-[10px] bg-card px-3.5 text-[14px] font-semibold shadow-tile hover:bg-raised"
        >
          <GitHubMark size={16} />
          GitHub
        </a>
      )}
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]')
  const markScrolled = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8)
  markScrolled()
  addEventListener('scroll', markScrolled, { passive: true })

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark')
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light')
    } catch {
      // Private mode: the choice lasts for this page only.
    }
  })
</script>
