# Copy to .env (or .env.local) to build the extension against your own sync server.
# Without it, builds sync with the server set in src/sync/server.ts.
WXT_SYNC_SERVER=https://tabs.example.com
# The website the "TabCabin" link in Settings opens. Without it, the link opens the project on GitHub.
WXT_SITE_URL=https://example.com
