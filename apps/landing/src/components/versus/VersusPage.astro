---
/**
 * Two other tab managers compared head to head (people search for "X vs Y"), with TabCabin as a
 * third option and the way over from either one.
 */
import Footer from '../Footer.astro'
import GetExtension from '../GetExtension.astro'
import Icon from '../Icon.astro'
import Nav from '../Nav.astro'
import Layout from '../../layouts/Layout.astro'
import { type Versus, versus, versusPath } from '../../versus'
import VersusTable from './VersusTable.astro'

interface Props {
  pair: Versus
}

const { pair } = Astro.props
const [a, b] = pair.names
const path = versusPath(pair.slug)
const others = versus.filter((other) => other.slug !== pair.slug)

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${a} vs ${b}`,
  description: pair.description,
  image: new URL('/og.png', Astro.site).toString(),
  inLanguage: 'en',
  datePublished: pair.published,
  dateModified: pair.updated ?? pair.published,
  author: { '@type': 'Person', name: 'Michał Jasiński' },
  publisher: { '@type': 'Organization', name: 'TabCabin' },
  mainEntityOfPage: new URL(path, Astro.site).toString(),
}
const link = 'font-medium text-accent-ink hover:underline'
---

<Layout
  title={`${pair.title} — TabCabin`}
  description={pair.description}
  path={path}
  schema={[article]}
  breadcrumbs={[
    ['Alternatives', '/alternatives/'],
    [`${a} vs ${b}`, path],
  ]}
>
  <Nav />
  <main class="mx-auto max-w-4xl px-5 py-16 sm:py-24">
    <nav class="mb-8 text-[13.5px] text-ink-3" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink">
        Home
      </a>{' '}
      /
      <a href="/alternatives/" class="hover:text-ink">
        Alternatives
      </a>{' '}
      /
      <span class="text-ink-2">
        {a} vs {b}
      </span>
    </nav>
    <h1
      class="text-[38px] leading-[1.08] font-semibold tracking-[-0.035em] sm:text-[52px]"
      data-reveal
    >
      {a} vs {b}
    </h1>
    <p class="mt-6 text-[18px] leading-relaxed text-ink-2" data-reveal="0.05">
      {pair.intro}
    </p>
    <div
      class="mt-8 rounded-[18px] bg-card p-6 text-[16px] leading-relaxed text-ink-2 shadow-card"
      data-reveal="0.08"
    >
      <strong class="text-ink">Short answer:</strong> {pair.short}
    </div>

    <VersusTable caption={`${a}, ${b} and TabCabin compared`} names={pair.names} rows={pair.rows} />
    <p class="mt-3 text-[13px] text-ink-3">
      Based on public information about {a} and {b} in {pair.checked}. Features change — check their
      websites for the latest.
    </p>

    <section class="mt-16" data-reveal>
      <h2 class="text-[28px] font-semibold tracking-[-0.025em]">Where they differ</h2>
      {pair.differences.map(([heading, text]) => (
        <>
          <h3 class="mt-8 text-[18px] font-semibold">{heading}</h3>
          <p class="mt-2 text-[16px] leading-relaxed text-ink-2">{text}</p>
        </>
      ))}
    </section>

    <div class="mt-16 grid gap-10 md:grid-cols-2">
      {pair.names.map((name, index) => (
        <section data-reveal={index * 0.05}>
          <h2 class="text-[24px] font-semibold tracking-[-0.02em]">Pick {name} if</h2>
          <ul class="mt-4 flex flex-col gap-3 text-[15.5px] leading-relaxed text-ink-2">
            {pair.pick[index]!.map((point) => (
              <li class="flex gap-2.5">
                <span class="mt-0.5 shrink-0 text-ink-3">
                  <Icon name="ArrowRight" size={18} />
                </span>
                {point}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <section
      id="third-option"
      class="mt-16 scroll-mt-24 rounded-[20px] bg-panel p-8 ring-1 ring-line"
      data-reveal
    >
      <h2 class="text-[24px] font-semibold tracking-[-0.02em]">A third option: TabCabin</h2>
      <p class="mt-3 text-[15.5px] leading-relaxed text-ink-2">
        TabCabin is a free, open-source tab manager that turns the new tab page into boards of saved
        tabs, notes and to-dos.
      </p>
      <ul class="mt-4 flex flex-col gap-3 text-[15.5px] leading-relaxed text-ink-2">
        {pair.third.map((point) => (
          <li class="flex gap-2.5">
            <span class="mt-0.5 shrink-0 text-success">
              <Icon name="Check" size={18} />
            </span>
            {point}
          </li>
        ))}
      </ul>
      <p class="mt-6 text-[15.5px] text-ink-2">
        Coming from one of them? Step by step:{' '}
        <a class={link} href={`/alternatives/${pair.slugs[0]}/#moving`}>
          moving from {a}
        </a>{' '}
        ·{' '}
        <a class={link} href={`/alternatives/${pair.slugs[1]}/#moving`}>
          moving from {b}
        </a>
      </p>
      <GetExtension label="Get TabCabin" size="md" class="mt-8" />
    </section>

    <p class="mt-12 text-[15px] text-ink-2">
      See also:{' '}
      {others.map((other) => (
        <>
          <a class={link} href={versusPath(other.slug)}>
            {other.names[0]} vs {other.names[1]}
          </a>{' '}
          ·{' '}
        </>
      ))}
      <a class={link} href={`/alternatives/${pair.slugs[0]}/`}>
        {a} alternative
      </a>{' '}
      ·{' '}
      <a class={link} href={`/alternatives/${pair.slugs[1]}/`}>
        {b} alternative
      </a>{' '}
      ·{' '}
      <a class={link} href="/alternatives/">
        all comparisons
      </a>
    </p>
  </main>
  <Footer />
</Layout>
