{
  "name": "@tabcabin/extension",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "icons": "node --experimental-strip-types scripts/icons.ts",
    "brand": "playwright test -c playwright.screenshots.config.ts brand",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "build:e2e": "wxt build --mode e2e",
    "screenshots": "wxt build --mode e2e && playwright test -c playwright.screenshots.config.ts readme demo",
    "store-assets": "wxt build --mode e2e && playwright test -c playwright.screenshots.config.ts store",
    "store-upload": "node --experimental-strip-types scripts/store/publish.ts",
    "promo": "wxt build --mode e2e && playwright test -c playwright.screenshots.config.ts promo/footage promo/render && node --experimental-strip-types scripts/promo/encode.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@tabcabin/core": "workspace:*",
    "@tabcabin/ui": "workspace:*",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "emojibase-data": "^17.0.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tabcabin/server": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.5",
    "gifenc": "^1.0.3",
    "jsdom": "^30.1.2",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
