---
import Footer from './Footer.astro'
import Icon from './Icon.astro'
import Nav from './Nav.astro'
import Layout from '../layouts/Layout.astro'
import { comparisons, releases } from '../site'

type Cell = true | false | string

interface Props {
  name: string
  slug: string
  intro: string
  /** One-line description of the other tool, fair and factual. */
  about: string
  rows: [string, Cell, Cell][]
  betterFit: string[]
  whySwitch: string[]
  moving: string[]
}

const { name, slug, intro, about, rows, betterFit, whySwitch, moving } = Astro.props
const title = `${name} alternative: TabCabin, a free, open-source tab manager you can self-host`
const description = `Comparing ${name} and TabCabin: boards, notes, reminders, privacy and sync. TabCabin is a free, open-source ${name} alternative you can self-host.`
---

<Layout
  title={title}
  description={description}
  path={`/alternatives/${slug}`}
  breadcrumbs={[
    ['Alternatives', '/alternatives/'],
    [`${name} alternative`, `/alternatives/${slug}`],
  ]}
>
  <Nav />
  <main class="mx-auto max-w-4xl px-5 py-16 sm:py-24">
    <nav class="mb-8 text-[13.5px] text-ink-3" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink">
        Home
      </a>{' '}
      /
      <a href="/alternatives/" class="hover:text-ink">
        Alternatives
      </a>{' '}
      /<span class="text-ink-2">{name}</span>
    </nav>
    <h1
      class="text-[38px] leading-[1.08] font-semibold tracking-[-0.035em] sm:text-[52px]"
      data-reveal
    >
      A calm, open-source alternative to {name}
    </h1>
    <p class="mt-6 text-[18px] leading-relaxed text-ink-2" data-reveal="0.05">
      {intro}
    </p>
    <p class="mt-4 text-[15.5px] leading-relaxed text-ink-3" data-reveal="0.08">
      {about}
    </p>

    <div class="mt-12 overflow-hidden rounded-[18px] bg-card shadow-card" data-reveal="0.1">
      <table class="w-full text-left text-[15px]">
        <caption class="sr-only">{name}compared with TabCabin</caption>
        <thead class="bg-subtle text-[13.5px] text-ink-2">
          <tr>
            <th class="px-5 py-3.5 font-semibold" scope="col">
              Feature
            </th>
            <th class="px-5 py-3.5 font-semibold" scope="col">
              {name}
            </th>
            <th class="px-5 py-3.5 font-semibold text-accent-ink" scope="col">
              TabCabin
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map(([feature, other, ours]) => (
            <tr class="border-t border-line">
              <th class="px-5 py-3.5 font-medium" scope="row">
                {feature}
              </th>
              {[other, ours].map((cell) => (
                <td class="px-5 py-3.5 text-ink-2">
                  {cell === true ? (
                    <span class="inline-flex items-center gap-1.5 text-success">
                      <Icon name="Check" size={18} /> <span class="sr-only">Yes</span>
                    </span>
                  ) : cell === false ? (
                    <span class="text-ink-3">
                      — <span class="sr-only">No</span>
                    </span>
                  ) : (
                    cell
                  )}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-[13px] text-ink-3">
      Based on public information about {name} in September 2026. Features change — check their
      website for the latest.
    </p>

    <div class="mt-16 grid gap-10 md:grid-cols-2">
      <section data-reveal>
        <h2 class="text-[24px] font-semibold tracking-[-0.02em]">Why people pick TabCabin</h2>
        <ul class="mt-4 flex flex-col gap-3 text-[15.5px] leading-relaxed text-ink-2">
          {whySwitch.map((point) => (
            <li class="flex gap-2.5">
              <span class="mt-0.5 shrink-0 text-success">
                <Icon name="Check" size={18} />
              </span>
              {point}
            </li>
          ))}
        </ul>
      </section>
      <section data-reveal="0.05">
        <h2 class="text-[24px] font-semibold tracking-[-0.02em]">
          When {name} may suit you better
        </h2>
        <ul class="mt-4 flex flex-col gap-3 text-[15.5px] leading-relaxed text-ink-2">
          {betterFit.map((point) => (
            <li class="flex gap-2.5">
              <span class="mt-0.5 shrink-0 text-ink-3">
                <Icon name="ArrowRight" size={18} />
              </span>
              {point}
            </li>
          ))}
        </ul>
      </section>
    </div>

    <section
      id="moving"
      class="mt-16 scroll-mt-24 rounded-[20px] bg-panel p-8 ring-1 ring-line"
      data-reveal
    >
      <h2 class="text-[24px] font-semibold tracking-[-0.02em]">Moving your tabs from {name}</h2>
      <ol class="mt-4 flex list-decimal flex-col gap-2.5 pl-5 text-[15.5px] leading-relaxed text-ink-2">
        {moving.map((step) => (
          <li set:html={step} />
        ))}
      </ol>
      <a
        href={releases}
        class="mt-8 inline-flex h-11 items-center gap-2 rounded-xl bg-accent px-5 text-[15px] font-semibold text-on-accent shadow-tile hover:brightness-110"
      >
        <Icon name="Download" size={17} /> Get TabCabin
      </a>
    </section>

    <p class="mt-12 text-[15px] text-ink-2">
      See also:
      {comparisons
        .filter((other) => other.slug !== slug)
        .map((other) => (
          <>
            <a
              class="font-medium text-accent-ink hover:underline"
              href={`/alternatives/${other.slug}`}
            >
              {other.name} alternative
            </a>{' '}
            ·{' '}
          </>
        ))}
      <a class="font-medium text-accent-ink hover:underline" href="/alternatives/">
        all comparisons
      </a>{' '}
      ·{' '}
      <a class="font-medium text-accent-ink hover:underline" href="/self-hosted-tab-manager">
        self-hosted tab manager
      </a>
    </p>
  </main>
  <Footer />
</Layout>
