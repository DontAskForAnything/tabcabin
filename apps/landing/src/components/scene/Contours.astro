---
/**
 * A piece of a hiking map behind the self-hosting section: contour lines around a hill, every
 * fifth one heavier, a few heights, and the cabin at the top. The map starts 260 px above the
 * section and fades in under the one before it and out before the next, so it never ends at a
 * hard edge.
 */
import { contour, contourPoint } from '../../lib/contours'
import { round } from '../../lib/landscape'

const hills = [
  { cx: 1150, cy: 410, rings: 22, wobble: [0.22, 0.15] as [number, number], top: 1240 },
  { cx: 250, cy: 960, rings: 9, wobble: [0.4, 0.3] as [number, number], top: 980 },
]
const lines = hills.flatMap((hill) =>
  Array.from({ length: hill.rings }, (_, i) => ({
    d: contour(hill.cx, hill.cy, 10 + (i + 1) * 17, i + 1, hill.wobble),
    index: (i + 1) % 5 === 0,
  })),
)
// Heights on the heavier lines, 20 m apart, read off the big hill.
const big = hills[0]!
const labels = [5, 10, 15].map((level) => {
  const [x, y] = contourPoint(big.cx, big.cy, 10 + level * 17, level, big.wobble, 2.5)
  return { x: round(x), y: round(y), text: String(big.top - level * 20) }
})
---

<svg
  class="contours pointer-events-none absolute inset-x-0 -top-[260px] bottom-0 -z-10 h-[calc(100%+260px)] w-full"
  viewBox="0 0 1440 1060"
  preserveAspectRatio="xMaxYMin slice"
  aria-hidden="true"
>
  {lines.map((line) => (
    <path
      d={line.d}
      fill="none"
      stroke-width={line.index ? 1.4 : 1}
      style={`stroke: var(${line.index ? '--contour-index' : '--contour'})`}
    />
  ))}
  {labels.map((label) => (
    <text x={label.x} y={label.y} text-anchor="middle" class="fill-ink-4 text-[10.5px] font-medium">
      {label.text}
    </text>
  ))}
  <g class="contours-mark" transform={`translate(${big.cx} ${big.cy + 4})`}>
    <path d="M-12 -10 0 -20 12 -10 V2 H-12Z" class="fill-accent"></path>
    <rect x="4.5" y="-22" width="4" height="9" class="fill-accent"></rect>
    <text x="20" y="1" class="fill-ink-3 text-[12px] font-semibold">
      Your cabin
    </text>
  </g>
</svg>

<style>
  .contours {
    mask-image:
      linear-gradient(to bottom, transparent, #000 320px, #000 calc(100% - 220px), transparent),
      radial-gradient(ellipse 75% 85% at 78% 40%, #000 35%, transparent 100%);
    mask-composite: intersect;
  }
  /* On narrow screens the text runs over the map: keep the lines quieter and drop the marker. */
  @media (max-width: 1023px) {
    .contours {
      opacity: 0.55;
    }
    .contours-mark {
      display: none;
    }
  }
</style>
