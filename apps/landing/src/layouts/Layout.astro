---
import bricolage from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url'
import geist from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  /** Path of the page, for the canonical link. */
  path?: string
  /** Extra JSON-LD objects (FAQ, breadcrumbs…). */
  schema?: object[]
  /** Breadcrumb trail for subpages: [name, path][]. */
  breadcrumbs?: [string, string][]
}

const { title, description, path = '/', schema = [], breadcrumbs } = Astro.props
const canonical = new URL(path, Astro.site)
const ogImage = new URL('/og.png', Astro.site)
import { repo } from '../site'
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'TabCabin',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'Chrome, Edge, Brave',
  description,
  url: Astro.site?.toString(),
  license: 'https://opensource.org/licenses/MIT',
  codeRepository: repo,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- The headline and body fonts arrive with the page, so the hero does not jump when they swap in. -->
    <link rel="preload" href={bricolage} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f2eee5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1110" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TabCabin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {schema.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    {breadcrumbs && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'BreadcrumbList',
          itemListElement: [['Home', '/'], ...breadcrumbs].map(([name, itemPath], index) => ({
            '@type': 'ListItem',
            position: index + 1,
            name,
            item: new URL(itemPath, Astro.site).toString(),
          })),
        })}
      />
    )}

    <!-- Apply the saved or system theme before the first paint. -->
    <script is:inline>
      ;(() => {
        let theme = null
        try {
          theme = localStorage.getItem('theme')
        } catch {}
        const dark = theme ? theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches
        document.documentElement.classList.toggle('dark', dark)
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
          document.documentElement.classList.add('motion-ok')
      })()
    </script>
  </head>
  <body class="min-h-screen">
    <slot />
    <script>
      import { animate, inView } from 'motion'

      // The drawings (smoke, birds, stars) start moving a moment after the page has loaded.
      if (document.documentElement.classList.contains('motion-ok')) {
        const wake = () =>
          setTimeout(() => document.documentElement.classList.add('scene-awake'), 1000)
        if (document.readyState === 'complete') wake()
        else addEventListener('load', wake, { once: true })
      }

      // Fade sections in as they scroll into view (only when motion is welcome).
      if (document.documentElement.classList.contains('motion-ok')) {
        document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
          inView(
            el,
            () => {
              void animate(
                el,
                { opacity: [0, 1], y: [22, 0] },
                { duration: 0.7, delay: Number(el.dataset.reveal || 0), ease: [0.2, 0.7, 0.2, 1] },
              )
            },
            { amount: 0.25 },
          )
        })
      }
    </script>
  </body>
</html>
