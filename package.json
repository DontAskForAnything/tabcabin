{
  "name": "tabhangar",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted tab manager: kanban boards and collections for your tabs, notes and to-dos.",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @tabhangar/server --filter @tabhangar/web dev",
    "dev:server": "pnpm --filter @tabhangar/server dev",
    "dev:web": "pnpm --filter @tabhangar/web dev",
    "dev:ext": "pnpm --filter @tabhangar/extension dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
