---
/** The promo film inline: it plays muted while on screen; the controls turn the music on. */
---

<section class="py-24" id="demo">
  <div class="mx-auto max-w-6xl px-5">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-[34px] font-semibold tracking-[-0.03em] sm:text-[44px]">
        See it in under a minute
      </h2>
      <p class="mt-4 text-[17px] text-ink-2" data-reveal="0.05">
        Dragging tabs into groups, saving any page with a note,{' '}
        <span class="whitespace-nowrap">to-dos</span>, search, collections, reminders, the dark
        theme and sync. Turn the sound on for the music.
      </p>
    </div>
    <div
      class="mt-12 overflow-hidden rounded-[22px] bg-black shadow-pop ring-1 ring-line"
      data-reveal="0.1"
    >
      <video
        class="block aspect-video w-full"
        src="/promo.mp4"
        poster="/promo-poster.jpg"
        muted
        loop
        playsinline
        controls
        preload="none"
        aria-label="TabCabin film"
        data-autoplay-video
      ></video>
    </div>
  </div>
</section>

<script>
  // Load and play only while the film is on screen (and never when motion is reduced).
  const video = document.querySelector<HTMLVideoElement>('[data-autoplay-video]')
  if (video && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    new IntersectionObserver(
      ([entry]) => {
        if (entry?.isIntersecting) void video.play().catch(() => undefined)
        else video.pause()
      },
      { threshold: 0.4 },
    ).observe(video)
  }
</script>
