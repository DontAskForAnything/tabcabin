---
import Footer from '../components/Footer.astro'
import Icon from '../components/Icon.astro'
import Logo from '../components/Logo.astro'
import Nav from '../components/Nav.astro'
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="Page not found — TabCabin"
  description="This page does not exist. Head back to TabCabin, the calm open-source tab manager."
  path="/404"
>
  <Nav />
  <main class="mx-auto flex max-w-xl flex-col items-center px-5 py-28 text-center">
    <Logo size={72} />
    <h1 class="mt-6 font-display text-[38px] font-bold tracking-[-0.025em]">Nobody lives here</h1>
    <p class="mt-4 text-[17px] text-ink-2">
      The page you are looking for does not exist — maybe it was never saved.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex h-11 items-center gap-2 rounded-xl bg-accent px-5 text-[15px] font-semibold text-on-accent shadow-glow hover:brightness-110"
    >
      Back to the cabin <Icon name="ArrowRight" size={16} />
    </a>
  </main>
  <Footer />
</Layout>
